package com.govtech.citizen.dashboard.service;

import java.math.BigDecimal;

import org.springframework.stereotype.Service;

import com.govtech.citizen.clients.ApplicationClient;
import com.govtech.citizen.clients.DocumentClient;
import com.govtech.citizen.clients.EligibilityClient;
import com.govtech.citizen.clients.ProfileClient;
import com.govtech.citizen.dashboard.dto.ApplicationsSummaryDto;
import com.govtech.citizen.dashboard.dto.DashboardResponse;
import com.govtech.citizen.dashboard.dto.DocumentSummaryDto;
import com.govtech.citizen.dashboard.dto.EligibilitySummaryDto;
import com.govtech.citizen.dashboard.dto.HouseholdDto;
import com.govtech.citizen.dashboard.dto.NotificationSummaryDto;

import lombok.RequiredArgsConstructor;

@Service
@RequiredArgsConstructor
public class DashboardService {

        private final DocumentClient documentClient;
        private final ApplicationClient applicationClient;
        private final ProfileClient profileClient;
        private final EligibilityClient eligibilityClient;

        public DashboardResponse getDashboard() {

                return DashboardResponse.builder()

                                .household(
                                                HouseholdDto.builder()
                                                                .city("Tourcoing")
                                                                .housingStatus("TENANT")
                                                                .children(3)
                                                                .singleParent(false)
                                                                .build())

                                .benefits(
                                                new EligibilitySummaryDto(
                                                                3,
                                                                0,
                                                                new BigDecimal("545.48")))

                                .notifications(
                                                new NotificationSummaryDto(
                                                                2,
                                                                2))

                                .documents(
                                                new DocumentSummaryDto(
                                                                4,
                                                                3,
                                                                1))

                                .applications(
                                                new ApplicationsSummaryDto(
                                                                1,
                                                                0,
                                                                1,
                                                                0,
                                                                0,
                                                                0))

                                .build();
        }
}