{
  "namespace": "com.govtech.events.security",
  "type": "record",
  "name": "DocumentSecurityCheckedEvent",
  "doc": "Event emitted when a document security check has completed.",

  "fields": [

    {
      "name": "baseEvent",
      "type": "com.govtech.events.common.DocumentBaseEvent"
    },

    {
      "name": "securityStatus",
      "type": {
        "type": "string",
        "avro.java.string": "String"
      },
      "doc": "Security result: CLEAN, INFECTED, REJECTED"
    },

    {
      "name": "scanEngine",
      "type": [
        "null",
        {
          "type": "string",
          "avro.java.string": "String"
        }
      ],
      "default": null,
      "doc": "Security scanner used (ClamAV, etc.)"
    },

    {
      "name": "scannedAt",
      "type": {
        "type": "string",
        "avro.java.string": "String"
      },
      "doc": "Security check timestamp"
    },

    {
      "name": "detectedContentType",
      "type": [
        "null",
        {
          "type": "string",
          "avro.java.string": "String"
        }
      ],
      "default": null
    }

  ]
}