{
  "namespace": "com.govtech.events.document",
  "type": "record",
  "name": "DocumentUploadedEvent",

  "doc": "Event emitted when a document has been uploaded, stored and is ready for processing.",

  "fields": [

    {
      "name": "baseEvent",
      "type": "com.govtech.events.common.DocumentBaseEvent",
      "doc": "Common document metadata."
    },

    {
      "name": "connectorName",
      "type": [
        "null",
        {
          "type": "string",
          "avro.java.string": "String"
        }
      ],
      "default": null,
      "doc": "Connector identifier when document originates from an external connector."
    },


    {
      "name": "connectorType",
      "type": [
        "null",
        "com.govtech.events.connector.ConnectorType"
      ],
      "default": null,
      "doc": "Connector category."
    },


    {
      "name": "sourceUri",
      "type": [
        "null",
        {
          "type": "string",
          "avro.java.string": "String"
        }
      ],
      "default": null,
      "doc": "Original document URI."
    },


    {
      "name": "territoryCode",
      "type": [
        "null",
        {
          "type": "string",
          "avro.java.string": "String"
        }
      ],
      "default": null,
      "doc": "Territorial scope."
    },


    {
      "name": "metadata",
      "type": {
        "type": "map",
        "values": {
          "type": "string",
          "avro.java.string": "String"
        }
      },
      "default": {},
      "doc": "Additional document metadata."
    },


    {
      "name": "uploadedAt",
      "type": {
        "type": "string",
        "avro.java.string": "String"
      },
      "doc": "Timestamp when document was uploaded."
    }

  ]
}