{
  "namespace": "com.govtech.events.document",
  "type": "record",
  "name": "DocumentExtractionCompletedEvent",

  "doc": "Document extraction completed for a platform document (user upload or external connector document).",

  "fields": [

    {
      "name": "baseEvent",
      "type": "com.govtech.events.common.DocumentBaseEvent",
      "doc": "Common document metadata."
    },


    {
      "name": "connectorName",
      "type": [
        "null",
        {
          "type": "string",
          "avro.java.string": "String"
        }
      ],
      "default": null,
      "doc": "Connector identifier when document comes from an external connector."
    },


    {
      "name": "connectorType",
      "type": [
        "null",
        "com.govtech.events.connector.ConnectorType"
      ],
      "default": null,
      "doc": "Connector category when document comes from external source."
    },


    {
      "name": "sourceUri",
      "type": [
        "null",
        {
          "type": "string",
          "avro.java.string": "String"
        }
      ],
      "default": null,
      "doc": "Original document URI."
    },


    {
      "name": "territoryCode",
      "type": [
        "null",
        {
          "type": "string",
          "avro.java.string": "String"
        }
      ],
      "default": null,
      "doc": "Territorial scope."
    },



    {
      "name": "text",
      "type": "string",
      "doc": "OCR extracted text."
    },


   


    {
      "name": "processedAt",
      "type": "string",
      "doc": "OCR completion timestamp."
    },


    {
      "name": "metadata",
      "type": {
        "type": "map",
        "values": {
          "type": "string",
          "avro.java.string": "String"
        }
      },
      "default": {},
      "doc": "Additional metadata."
    },
    {
      "name": "extractionType",
      "type": [
        "null",
        {
          "type": "string",
          "avro.java.string": "String"
        }
      ],
      "default": null,
      "doc": "Extraction strategy used (OCR, CSV, ZIP, JSON, XML, TEXT, OFFICE...)."
    },
    {
      "name": "extractedContentType",
      "type": [
        "null",
        {
          "type": "string",
          "avro.java.string": "String"
        }
      ],
      "default": null,
      "doc": "Content type produced by the extraction process."
    }
  ]
}